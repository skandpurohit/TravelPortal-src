    name: results
    script: |
      #!/usr/bin/env python3

      import tomllib
      import os

      print("======================================")
      print("Reading image digest from report.toml")
      print("======================================")

      with open("/layers/report.toml", "rb") as f:
          data = tomllib.load(f)

      img_data = data.get("image", {})

      digest = img_data.get("digest")

      print("Image digest:")
      print(digest)

      if not digest:
          print("ERROR: Image digest not found in report.toml")
          exit(1)

      digest = digest.strip()

      # ------------------------------------------------------------
      # 1. Write Tekton result
      # ------------------------------------------------------------

      tekton_result = "$(results.APP_IMAGE_DIGEST.path)"

      with open(tekton_result, "w") as f:
          f.write(digest)

      print("")
      print("Tekton result written:")
      print(tekton_result)

      # ------------------------------------------------------------
      # 2. Write digest to shared source workspace
      # ------------------------------------------------------------

      digest_file = "$(workspaces.source.path)/image-digest"

      print("")
      print("Writing digest file:")
      print(digest_file)

      with open(digest_file, "w") as f:
          f.write(digest)

      # ------------------------------------------------------------
      # 3. Verify digest file
      # ------------------------------------------------------------

      print("")
      print("======================================")
      print("Verifying image-digest file")
      print("======================================")

      if not os.path.isfile(digest_file):
          print("ERROR: Failed to create image-digest file")
          exit(1)

      with open(digest_file, "r") as f:
          stored_digest = f.read().strip()

      print("File exists: YES")
      print("File content:")
      print(stored_digest)

      if stored_digest != digest:
          print("ERROR: Digest mismatch")
          exit(1)

      print("")
      print("SUCCESS: image-digest file created successfully")
      print("Digest:", stored_digest)
