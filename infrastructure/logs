    - name: PARAM_CNB_PLATFORM_API
      value: $(params.CNB_PLATFORM_API)
    - name: PARAM_CNB_PLATFORM_API_SUPPORTED
      value: $(params.CNB_PLATFORM_API_SUPPORTED)
